['polaroid_camera'] = {
    label = 'ポラロイドカメラ',
    weight = 400,
    stack = true,
    consume = 0,
    close = true,
    description = '撮影してインベントリに写真を追加します。',
    client = {
        image  = 'polaroid_camera.png',
        export = 'polapaint.useCamera',
    },
},

['polaroid_photo'] = {
    label = 'ポラロイド写真',
    weight = 50,
    stack = false,
    consume = 0,
    close = true,
    description = '写真。USE で落書き編集、ボタンから閲覧。',
    client = {
        image  = 'polaroid_photo.png',
        export = 'polapaint.usePhoto',
    },
    buttons = {
        {
            label = '閲覧',
            action = function(slot)
                exports['polapaint']:openPhotoViewer(slot)
            end,
        },
    },
},
